{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Track ghcr.io image references used inside composer.json scripts, which no built-in manager looks at",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)composer\\.json$/"],
      "matchStrings": [
        "(?<depName>ghcr\\.io/[^\\s\"'@:]+):(?<currentValue>[^\\s\"'@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
